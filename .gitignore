# Byte-compiled / optimized
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Distribution / packaging
build/
# dist/ 是构建产物，但离线单文件版要进仓库：
# 它的意义就是「不装任何东西也能双击打开」，如果还得先装 Python 来生成它，就自相矛盾了。
dist/*
!dist/paper-recycle-offline.html

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage
_pytest_tmp/

# 模型 API 配置：含明文密钥，绝不入库
config/llm.json
# 用户导入的真实投入产出表（版权数据，不入库）
data/io_matrix.csv
# 本地企业名录（真实数据，不入库；模板是 enterprises.csv.example）
data/enterprises.csv

# Editor / OS
.idea/
.vscode/
.DS_Store
*.log
